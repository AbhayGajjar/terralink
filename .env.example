# Copy this file to .env.local and fill in real values.
# Never commit .env.local – it is already ignored by git.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# Where quote requests are delivered. Separate multiple addresses with commas.
CONTACT_EMAIL=quotes@terralink.com.au

# Optional: the "from" address. Must be on a domain verified in Resend.
# Until your domain is verified, leave this unset to use Resend's test sender (onboarding@resend.dev),
# which can only deliver to the email address on your Resend account.
CONTACT_FROM_EMAIL="TerraLink Website <website@terralink.com.au>"

# Optional: public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.terralink.com.au
